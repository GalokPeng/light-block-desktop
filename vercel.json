{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "node --version",
  "outputDirectory": "site/public",
  "trailingSlash": true,
  "functions": {
    "api/setup.mjs": { "maxDuration": 80 }
  },
  "rewrites": [
    {
      "source": "/download/",
      "destination": "/api/setup"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
