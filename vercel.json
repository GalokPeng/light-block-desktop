{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/build_desktop_demo.mjs",
  "installCommand": "node --version",
  "outputDirectory": "site/public",
  "trailingSlash": true,
  "functions": {
    "api/setup.mjs": {
      "maxDuration": 80
    }
  },
  "rewrites": [
    {
      "source": "/download/",
      "destination": "/api/setup"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/preview/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/preview/",
      "destination": "/en/",
      "permanent": true
    }
  ]
}
